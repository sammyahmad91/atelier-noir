# Local development works with no env at all (SQLite file + dev session secret).

# libSQL / SQLite connection. Use a Turso URL in production, e.g. libsql://atelier-noir-<you>.turso.io
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Required in production. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Noir AI provider. Only the built-in mock model ships today.
NOIR_PROVIDER=mock
